{
  "global-settings": {
    "run-at-startup": {
      "enabled": false
    }
  },
  "personalities": [
    {
      "name": "personality example",
      "enabled": true,
      "trigger-shortcut": "ctrl+win+z",
      "apps-to-launch": {
        "enabled": true,
        "paths": "WINWORD.EXE"
      },
      "tabs-to-open": {
        "enabled": true,
        "urls": "voidlauncher.qd.je"
      },
      "virtual-desktop-switch": {
        "enabled": true,
        "target-desktop-name": "personality example"
      },
      "system-settings-automation": {
        "enabled": true,
        "volume-level": 6,
        "do-not-disturb": true
      },
      "wallpaper-switch": {
        "enabled": true,
        "wallpaper-path": "scripts\\wallpaper_example.png"
      }
    }
  ],
  "feature-ram-monitor": {
    "enabled": false,
    "max-allowed-percentage": 85
  },
  "feature-smart-suggestions": {
    "enabled": false
  }
}
