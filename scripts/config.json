{
  "global-settings": {
    "General": {
      "StartWithWindows": false
    }
  },
  "personalities": [
    {
      "name": "Default",
      "enabled": true,
      "trigger-shortcut": "ctrl+alt+d",
      "apps-to-launch": {
        "enabled": true,
        "paths": "C:\\Windows\\explorer.exe"
      },
      "tabs-to-open": {
        "enabled": true,
        "urls": "https://www.google.com"
      },
      "virtual-desktop-switch": {
        "enabled": false,
        "target-desktop-name": "Desktop 1"
      },
      "system-settings-automation": {
        "enabled": true,
        "volume-level": 50,
        "do-not-disturb": false
      },
      "wallpaper-switch": {
        "enabled": false,
        "wallpaper-path": ""
      }
    },
    {
      "name": "Focus Mode",
      "enabled": true,
      "trigger-shortcut": "ctrl+alt+f",
      "apps-to-launch": {
        "enabled": false,
        "paths": ""
      },
      "tabs-to-open": {
        "enabled": true,
        "urls": "https://github.com"
      },
      "virtual-desktop-switch": {
        "enabled": false,
        "target-desktop-name": "Focus"
      },
      "system-settings-automation": {
        "enabled": true,
        "volume-level": 10,
        "do-not-disturb": true
      },
      "wallpaper-switch": {
        "enabled": false,
        "wallpaper-path": ""
      }
    }
  ],
  "feature-ram-monitor": {
    "enabled": true,
    "max-allowed-percentage": 85
  },
  "feature-smart-suggestions": {
    "enabled": true,
    "scan-interval-minutes": 5
  }
}